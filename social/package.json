{
  "name": "pravnya-social",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "studio": "npm run sync-assets && remotion studio",
    "render": "npm run sync-assets && node --env-file-if-exists=.env scripts/render.mjs",
    "typecheck": "tsc --noEmit",
    "tts": "node --env-file-if-exists=.env scripts/tts.mjs",
    "post": "node --env-file-if-exists=.env scripts/post.mjs",
    "review": "node scripts/review.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.538",
    "@remotion/cli": "4.0.538",
    "@remotion/google-fonts": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "esbuild": "0.28.1",
    "typescript": "5.9.3"
  }
}
