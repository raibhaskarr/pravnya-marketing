# Copy to .env (never commit .env).
SARVAM_API_KEY=
# Optional voice settings (bulbul:v3 speakers: priya, ritu, neha, kavya, shreya, aditya, rahul, …)
SARVAM_SPEAKER_EN=priya
SARVAM_SPEAKER_HI=priya
SARVAM_PACE=1

UPLOAD_POST_API_KEY=
# The Upload-Post profile name your social accounts are connected to.
UPLOAD_POST_USER=
# Only needed if several pages are connected.
FACEBOOK_PAGE_ID=
LINKEDIN_PAGE_ID=
POST_TIMEZONE=Asia/Kolkata
